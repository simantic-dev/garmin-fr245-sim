fg: I2C.ScriptedI2cSlave @ i2c3 0x36
    file: "peers/i2c/max17048.py"
pmic: I2C.ScriptedI2cSlave @ i2c3 0x28
    file: "peers/i2c/max20303.py"
    numberOfGpios: 1
    0 -> gpioa@21
hubspi: SPI.ScriptedSpiSlave @ spi2 0
    file: "peers/spi/garmin_sensor_hub_spi.py"
    numberOfGpios: 3
    0 -> gpiob@5
    2 -> gpioa@11
gpioa:
    27 -> hubspi@1
    pullUps: "20 22"
gpioc:
    pullUps: "11"
gpiod:
    pullUps: "1 10"
porta:
    pullUps: "20 22"
portc:
    pullUps: "11"
portd:
    pullUps: "1 10"
btn: Scripted.ScriptedGpioPeer @ none
    file: "peers/gpio/pin_script.py"
    config: "{\"holds\":[{\"line\":1,\"at_ms\":14000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":16000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":18000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":20000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":22000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":24000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":26000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":28000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":30000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":32000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":34000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":36000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":38000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":40000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":42000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":44000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":46000,\"for_ms\":300,\"level\":0},{\"line\":1,\"at_ms\":48000,\"for_ms\":300,\"level\":0}]}"
    numberOfGpios: 5
    0 -> gpioc@11
    1 -> gpiod@10
    2 -> gpiod@1
    3 -> gpioa@20
    4 -> gpioa@22
disp: Scripted.ScriptedGpioPeer @ none
    file: "peers/display/garmin_mip_parallel.py"
    config: "{\"png_dir\": \"out/frames\"}"
    numberOfGpios: 32
flexio0:
    34 -> disp@2
    35 -> disp@3
    36 -> disp@4
    37 -> disp@5
    38 -> disp@6
    39 -> disp@7
    45 -> disp@13
    46 -> disp@14
    59 -> disp@27
    60 -> disp@28
link: UART.ScriptedUartPeer @ sysbus 0x60200000
    file: "peers/uart/sony_cxd5603_gnss.py"
    baudRate: 115200
cyw: UART.ScriptedUartPeer @ sysbus 0x60200100
    file: "peers/uart/cyw20719_wiced.py"
    baudRate: 3000000

phone: UART.ScriptedUartPeer @ sysbus 0x60200200
    file: "peers/uart/ble_phone.py"
